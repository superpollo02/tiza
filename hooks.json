{
  "tiza-security-guard": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command|read_file|view_file|write_file|edit_file",
        "hooks": [
          {
            "type": "command",
            "command": "python ./scripts/tiza_guard.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
